# Общий ключ для «быстрых» комнат на тарифе по умолчанию (любое имя комнаты)
WAVECAST_KEY=change-me
# Токен админ-API (создание комнат, тарифы, ключи)
WAVECAST_ADMIN_TOKEN=change-me-too
# Публичный адрес, используется в ссылках из API
WAVECAST_PUBLIC_URL=https://cast.example.com
WAVECAST_DEFAULT_PLAN=free
# WAVECAST_PLANS=/data/plans.json

# Кластер: раскомментируй вместе с --profile cluster
# REDIS_URL=redis://redis:6379/0

# ИИ-диджей: любой OpenAI-совместимый API (OpenAI, OpenRouter, Ollama: http://host:11434/v1)
DJ_LLM_URL=https://api.openai.com/v1
DJ_LLM_KEY=
DJ_LLM_MODEL=gpt-4o-mini
# TTS: edge (бесплатно) или openai (OpenAI-совместимый /audio/speech)
DJ_TTS=edge
DJ_VOICE=ru-RU-DmitryNeural

# Распознавание через AcoustID вместо Shazam
# ACOUSTID_KEY=
